name: mlflow_indonesia_gdp
conda_env: conda.yaml

entry_points:
  main:
    parameters:
      data_path: {type: str, default: "namadataset_preprocessing/indonesia_gdp_preprocessed.csv"}
      test_size: {type: float, default: 0.2}
      random_state: {type: int, default: 42}
      experiment_name: {type: str, default: "Analisa_Ekonomi_Indonesia"}
    command: "python modelling.py --data_path {data_path} --test_size {test_size} --random_state {random_state} --experiment_name {experiment_name}"
